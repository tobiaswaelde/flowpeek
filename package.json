{
  "name": "flowpeek",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only workflow status dashboard for GitHub, GitLab, and Forgejo.",
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.15.1"
  },
  "scripts": {
    "build": "nx run-many -t build --all --parallel=2",
    "changeset": "changeset",
    "db:generate": "nx run api:db:generate",
    "dev": "nx run-many -t dev --all --parallel=2",
    "docker:build": "nx run-many -t docker:build --all --parallel=2",
    "lint": "nx run-many -t lint --all --parallel=2",
    "nx": "nx",
    "test": "nx run-many -t test --all --parallel=2",
    "typecheck": "nx run-many -t typecheck --all --parallel=2",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "nx": "^23.1.1",
    "typescript": "7.0.2"
  }
}
