# Local PostgreSQL bootstrap values. Replace all example credentials and keys
# before any shared or production deployment.
POSTGRES_DB=flowpeek
POSTGRES_USER=flowpeek
POSTGRES_PASSWORD=change-me

# API runtime configuration.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://flowpeek:change-me@localhost:5432/flowpeek?schema=public
SHADOW_DATABASE_URL=postgresql://flowpeek:change-me@localhost:5432/flowpeek_shadow?schema=public
CORS_ORIGIN=http://localhost:3000
PUBLIC_URL=http://localhost:3000

# Authentication and encrypted provider credentials. The example encryption
# value decodes to 32 bytes; create a unique replacement for every deployment.
AUTH_JWT_ISSUER=flowpeek
AUTH_JWT_SECRET=replace-with-a-long-random-jwt-secret
AUTH_JWT_EXPIRATION=7d
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me
TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# OAuth application registrations for provider accounts. Register the exact
# callback URL with every enabled provider. Keep client secrets out of Git.
OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/provider-accounts/oauth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_BASE_URL=https://gitlab.com
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
FORGEJO_OAUTH_BASE_URL=
FORGEJO_OAUTH_CLIENT_ID=
FORGEJO_OAUTH_CLIENT_SECRET=

# Background jobs. Set SCHEDULER_ENABLED=false for tests and one-off commands.
SCHEDULER_ENABLED=true
SCHEDULER_SYNC_INTERVAL_SECONDS=300

# SMTP is optional. When SMTP_HOST is set, SMTP_FROM is required. Set username
# and password together when the SMTP server uses authentication.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Docker Compose uses this to select matching API and web image versions.
FLOWPEEK_VERSION=latest
