enum UserRole {
  SYSTEM_ADMIN
  VIEWER
  MANAGER
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  username     String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         UserRole @default(VIEWER)

  @@map("users")
}
