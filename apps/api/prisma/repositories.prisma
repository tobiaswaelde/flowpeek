model Repository {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerRepositoryId String   @db.VarChar(255)
  owner                String   @db.VarChar(255)
  name                 String   @db.VarChar(255)
  url                  String   @db.VarChar(2048)
  enabled              Boolean  @default(true)
  lastSyncAt           DateTime?

  providerAccountId String          @db.Uuid
  providerAccount   ProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)

  @@unique([providerAccountId, providerRepositoryId])
  @@index([providerAccountId, enabled])
  @@map("repositories")
}
