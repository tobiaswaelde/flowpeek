/** Notification transports supported by repository-scoped channels. */
enum NotificationChannelType {
  EMAIL
  GOTIFY
  NTFY
}

/**
 * A destination configured for one tracked repository.
 *
 * `configuration` contains non-secret transport settings. Credentials are
 * stored separately in `encryptedSecret` and are never returned by the API.
 */
model NotificationChannel {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name            String                  @db.VarChar(255)
  type            NotificationChannelType
  enabled         Boolean                 @default(true)
  configuration   Json                    @default("{}")
  encryptedSecret String?                 @db.Text

  repositoryId String     @db.Uuid
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  ruleLinks    NotificationRuleChannel[]
  deliveryAttempts NotificationDeliveryAttempt[]

  @@unique([repositoryId, name])
  @@index([repositoryId, enabled])
  @@map("notification_channels")
}

/** Terminal workflow outcomes that can trigger notification rules. */
enum NotificationRuleOutcome {
  SUCCESS
  FAILED
}

/** A repository workflow glob matched against one terminal run outcome. */
model NotificationRule {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workflowPattern String                  @db.VarChar(1024)
  outcome         NotificationRuleOutcome
  enabled         Boolean                 @default(true)

  repositoryId String     @db.Uuid
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  channelLinks NotificationRuleChannel[]
  deliveries   NotificationDelivery[]

  @@index([repositoryId, enabled, outcome])
  @@map("notification_rules")
}

/** Joins a notification rule to each selected repository channel. */
model NotificationRuleChannel {
  notificationRuleId String           @db.Uuid
  notificationRule   NotificationRule @relation(fields: [notificationRuleId], references: [id], onDelete: Cascade)

  notificationChannelId String              @db.Uuid
  notificationChannel   NotificationChannel @relation(fields: [notificationChannelId], references: [id], onDelete: Cascade)

  @@id([notificationRuleId, notificationChannelId])
  @@index([notificationChannelId])
  @@map("notification_rule_channels")
}

/** Lifecycle states for a delivery created from one rule and workflow run. */
enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

/** One idempotent notification operation for a rule and a workflow run. */
model NotificationDelivery {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status     NotificationDeliveryStatus @default(PENDING)
  finalError String?                    @db.Text

  notificationRuleId String           @db.Uuid
  notificationRule   NotificationRule @relation(fields: [notificationRuleId], references: [id], onDelete: Cascade)

  workflowRunId String      @db.Uuid
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  attempts NotificationDeliveryAttempt[]

  @@unique([notificationRuleId, workflowRunId])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

/** A per-channel attempt belonging to one idempotent delivery. */
model NotificationDeliveryAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  attempt       Int
  deliveredAt   DateTime?
  error         String? @db.Text

  notificationDeliveryId String               @db.Uuid
  notificationDelivery   NotificationDelivery @relation(fields: [notificationDeliveryId], references: [id], onDelete: Cascade)

  notificationChannelId String              @db.Uuid
  notificationChannel   NotificationChannel @relation(fields: [notificationChannelId], references: [id], onDelete: Cascade)

  @@unique([notificationDeliveryId, notificationChannelId, attempt])
  @@index([notificationChannelId, createdAt])
  @@map("notification_delivery_attempts")
}
