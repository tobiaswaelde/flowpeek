meta {
  name: sign in
  type: http
  seq: 1
}

post {
  url: {{host}}/api/v1/auth/signin
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setEnvVar('token', res.body.accessToken);
}

settings {
  encodeUrl: true
  timeout: 0
}
